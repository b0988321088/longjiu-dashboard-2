# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/

# Environment / secrets
.env
.eggs/
*.pem
*.key
*credentials*
gmail_token.json

# Hermes runtime temp files
.hermes-tmp.*
schemas/.hermes-tmp.*

# Scripts
push_main.sh

# IDE
.vscode/
.idea/

# OS
Thumbs.db
Desktop.ini

# Project caches
*.log
*.tmp
.cache/

# Data exports (keep source, ignore large generated exports)
daily_reports_*.txt
moneybook/
hunter_logs/

# 影片成品（不推 Pages）
*.mp4
node_modules/
*.map
moneybook_tmp/

# OCR 暫存（含個資文字）
_ocr_*

# 審查落地檔（.git/CIO_APPROVED 才是正式紀錄；這裡只是落地時的暫存 JSON）
.cio_review*.json

# 工具備份（各工具寫入前的自動備份；留在磁碟、不入庫，避免 add -A 掃進 commit）
*.bak-*

# LLM 呼叫快取／耐久鏡像（本機留檔即可；分析結果另存於日報與 DB）
cache/llm_archive/

# LLM 每日輸出（日期檔名，逐日累積；分析結果已寫入日報/DB/報告頁）
data/buffett_*.json
data/cto_*.json
data/cio_llm_*.json
data/ceo_analysis_*.json

# 同一個 JSON 被拆檔/停用後留下的變體（xxx.json.first／.second／.stale-*）
data/*.json.*
