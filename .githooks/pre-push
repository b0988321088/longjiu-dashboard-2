#!/usr/bin/env bash
# 龍九 pre-push 閘門 v3（2026-09-14）
# 修正 v2 漏洞：只驗 HEAD tree → 改成驗「本次推送範圍內每一個 commit 的 tree」。
#
# 放行條件（逐 commit 判定，全部通過才放行）：
#   Lane RECORD     ：該 commit 的 tree hash 在 <git-dir>/CIO_APPROVED 有 APPROVE 紀錄
#                     （產生方式：CIO 審查通過後 python cio_approve.py --verdict APPROVE ...）
#   Lane TAG        ：該 commit message 含 [cioreviewed]（自動化腳本沿用；會寫入 PUSH_LANE.log 留痕）
#                     ★v4（2026-09-14）：TAG 只准推「純資料/報表產出」。變更清單若含程式檔
#                       （.py .sh .bat .ps1 .cmd .toml .yml .yaml .js .ts .sql、.githooks/*、
#                        .gitattributes、.gitignore、index_template.html）→ 一律擋下，必須走 RECORD。
#                       理由：標籤可自打，只該用於每晚重複的資料產出；程式與邏輯改動必須真審。
#   Lane SKIPREVIEW ：該 commit message 含 [skipreview]（緊急例外，留痕）
#                     ★v4：若同時含程式檔 → 記為 SKIPREVIEW-CODE（仍放行但大聲留痕，每日稽核會抓）
#   Lane DELETE     ：刪除分支（無內容上傳）
# 其餘一律擋下，並列出未通過的 commit 與 tree。
#
# 為何保留 TAG 通道：repo 內有 10 條自動化推送路徑（daily_push / update_and_deploy / evening_sync /
#   refresh_all / daily_deploy / regenerate_report / complete_operation / cioreview_ingest / safe_update /
#   cron 任務 prompt 直接下 git push），今晚若全面要求 RECORD 會直接斷 08:30 日報部署。
#   → RECORD 為正式通道；TAG 為自動化過渡通道（有紀錄可稽核），遷移另行排程。
set -u

GITDIR=$(git rev-parse --git-dir 2>/dev/null || echo .git)
APPROVE_FILE="$GITDIR/CIO_APPROVED"
LANE_LOG="$GITDIR/PUSH_LANE.log"
ZERO=0000000000000000000000000000000000000000

log_lane() { printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$3" >> "$LANE_LOG"; }

# v4：程式檔判定（TAG/SKIPREVIEW 通道不得推程式）
CODE_RE='(\.(py|sh|bat|ps1|cmd|toml|yml|yaml|js|ts|sql)$)|(^\.githooks/)|(^\.gitattributes$)|(^\.gitignore$)|(^index_template\.html$)'
# 回傳該 commit 相對第一 parent 的變更中屬於「程式檔」者（merge commit 一律保守視為程式變更）
code_files() {
  local c="$1" nparents files
  nparents=$(git rev-list --parents -n1 "$c" 2>/dev/null | wc -w)
  if [ "${nparents:-0}" -gt 2 ]; then echo "MERGE-COMMIT"; return 0; fi
  # --name-status -M：改名/複製時同時檢查「舊路徑與新路徑」，防「把程式檔改名成 .json 就繞過」
  # --root（2026-09-16 INC-204 沙箱發現）：沒有 parent 的根 commit，diff-tree 什麼都不印
  #   → 程式檔判定會靜默失效（沙箱案例 B 就是這樣漏擋）。加 --root 後根 commit 也照常檢查；
  #   一般有 parent 的 commit 行為完全不變。
  git diff-tree --root --no-commit-id --name-status -M -r "$c" 2>/dev/null \
    | while IFS=$'\t' read -r _st _p1 _p2; do printf '%s\n' "$_p1" "$_p2"; done \
    | grep -Ei "$CODE_RE" | head -5
}

BAD=""
CHECKED=0
SEEN=" "

check_one() {
  local c="$1" tree msg
  tree=$(git rev-parse "$c^{tree}" 2>/dev/null) || tree="UNKNOWN"
  # v4.2：只認「主旨行(%s)」——原本整段訊息(%B)比對，commit 內文提到 [cioreviewed] 也會被
  #       誤判成走了 TAG 通道（實測：P2 這顆 commit 的內文講到該標籤就被判 TAG-BLOCKED-CODE），
  #       通道判定必須看「作者是否真的下了那個標籤」＝主旨行。
  msg=$(git log -1 --pretty=%s "$c" 2>/dev/null || echo "")
  CHECKED=$((CHECKED + 1))
  if [ -f "$APPROVE_FILE" ]; then
    # v4.3（2026-09-16 INC-204）：自宣告紀錄（reviewer 以 SELF-DECLARED: 開頭 ＝ cio_approve.py
    # 沒收到 --result）不得替「含程式檔」的 tree 背書。先找非自宣告的 APPROVE；找不到才退回自宣告
    # （純資料 commit 行為不變）。★標記只在 reviewer 欄比對：第一版寫在 note，結果被 note 裡的
    # 敘述文字（「SELF-DECLARED 規則」）誤命中，把真審查紀錄擋掉。
    rev=$(awk -F'\t' -v t="$tree" '$2==t && $4=="APPROVE" && $5 !~ /^SELF-DECLARED:/{print $5; exit}' "$APPROVE_FILE")
    if [ -z "$rev" ]; then
      sd=$(awk -F'\t' -v t="$tree" '$2==t && $4=="APPROVE" && $5 ~ /^SELF-DECLARED:/{print $5; exit}' "$APPROVE_FILE")
      if [ -n "$sd" ]; then
        cf=$(code_files "$c")
        if [ -n "$cf" ]; then
          log_lane "SELF-DECLARED-BLOCKED-CODE" "$c" "$tree"
          BAD="$BAD  - commit ${c:0:12}  tree ${tree:0:12}  僅有自宣告紀錄（無審查者原文）但含程式檔\n      → $(printf '%s' "$cf" | tr '\n' ' ')\n"
          return 1
        fi
        rev="$sd"
      fi
    fi
    if [ -n "$rev" ]; then
      case "$rev" in
        AUTO-checker:*)
          # v4.2（2026-09-14）：AUTO-checker 只證明「deterministic 結構檢查通過」，
          # 不得涵蓋程式檔（程式/邏輯改動必須走真 CIO 審查）→ 擋下。
          cf=$(code_files "$c")
          if [ -n "$cf" ]; then
            log_lane "AUTO-BLOCKED-CODE" "$c" "$tree"
            BAD="$BAD  - commit ${c:0:12}  tree ${tree:0:12}  AUTO-checker 紀錄但含程式檔（v4.2 禁止 AUTO 背書程式）\n      → $(printf '%s' "$cf" | tr '\n' ' ')\n"
            return 1
          fi
          ;;
      esac
      log_lane "RECORD" "$c" "$tree"; return 0
    fi
  fi
  local cf
  if printf '%s' "$msg" | grep -q "\[cioreviewed\]"; then
    cf=$(code_files "$c")
    if [ -n "$cf" ]; then
      log_lane "TAG-BLOCKED-CODE" "$c" "$tree"
      BAD="$BAD  - commit ${c:0:12}  tree ${tree:0:12}  [cioreviewed] 但含程式檔（v4 禁止 TAG 推程式）\n      → $(printf '%s' "$cf" | tr '\n' ' ')\n"
      return 1
    fi
    log_lane "TAG" "$c" "$tree"; return 0
  fi
  if printf '%s' "$msg" | grep -q "\[skipreview\]"; then
    cf=$(code_files "$c")
    if [ -n "$cf" ]; then
      log_lane "SKIPREVIEW-CODE" "$c" "$tree"
      echo "⚠️  例外通道 [skipreview] 含程式檔（未經真審）：$(printf '%s' "$cf" | tr '\n' ' ')" >&2
    else
      log_lane "SKIPREVIEW" "$c" "$tree"
    fi
    return 0
  fi
  BAD="$BAD  - commit ${c:0:12}  tree ${tree:0:12}  （無審查紀錄、也無 [cioreviewed]/[skipreview]）\n"
  return 1
}

check_range() {
  local local_sha="$1" remote_sha="$2" commits c
  if [ "$remote_sha" = "$ZERO" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes 2>/dev/null)
  else
    commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null)
  fi
  [ -z "$commits" ] && return 0
  # v4.2：同一次 push 推多個 ref（clean-main + main）會讓同一批 commit 被檢查兩次
  # → 紀錄檔出現重複行、訊息把 1 筆說成 2 筆（稽核誤判「重複通道紀錄」）。用 SEEN 去重。
  for c in $commits; do
    case "$SEEN" in *" $c "*) continue;; esac
    SEEN="$SEEN$c "
    check_one "$c" || true
  done
}

# 由 git 透過 stdin 提供：<local_ref> <local_sha> <remote_ref> <remote_sha>
stdin_used=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  stdin_used=1
  if [ "$local_sha" = "$ZERO" ]; then
    log_lane "DELETE" "$remote_ref" "-"   # 刪除分支：無內容上傳
    continue
  fi
  check_range "$local_sha" "${remote_sha:-$ZERO}"
done

# 手動測試（無 stdin）時，退化成檢查 HEAD 相對上游/遠端
if [ "$stdin_used" = "0" ]; then
  HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
  UP=$(git rev-parse --verify --quiet '@{u}' 2>/dev/null || echo "")
  if [ -n "$UP" ]; then check_range "$HEAD_SHA" "$UP"; else check_range "$HEAD_SHA" "$ZERO"; fi
fi

if [ -z "$BAD" ]; then
  echo "✅ 推送閘門 v4：$CHECKED 個 commit 全數通過（紀錄見 $(basename "$LANE_LOG")）"
  exit 0
fi

cat <<EOF

╔══════════════════════════════════════════════╗
║  ❌ 推送被擋：有 commit 未通過審查           ║
╚══════════════════════════════════════════════╝
$(printf "$BAD")
  正確流程：
    1) 送 CIO 審查（delegate_task，指定檢查項目）
    2) CIO APPROVE 後落地紀錄：
         python cio_approve.py --verdict APPROVE --reviewer "CIO-Gemini" [--result <review.json>]
    3) 再 git push（紀錄綁 tree：改 message 不影響，改內容要重新送審）

  ⚠️ 例外通道：[cioreviewed] / [skipreview]（自動化與緊急用，全部留痕於 $(basename "$LANE_LOG")）

  ★ v4 規則：含程式檔的變更（.py .sh .bat .ps1 .cmd .toml .yml .yaml .js .ts .sql、
     .githooks/*、.gitattributes、.gitignore、index_template.html）不得走 [cioreviewed] 通道；
     自動化「資料/報表產出」不受影響。程式改動請送審後用 cio_approve.py 落地。
EOF
exit 1
